{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/reports/mo-auto-campaign-configuration-2026-09-23",
      "destination": "/reports/auto-campaign-configuration-2026-10-01",
      "permanent": false
    },
    {
      "source": "/reports/mo-home-campaign-configuration-2026-09-23",
      "destination": "/reports/home-campaign-configuration-2026-10-01",
      "permanent": false
    },
    {
      "source": "/reports/mo-auto-campaign-configuration-2026-09-23.html",
      "destination": "/reports/auto-campaign-configuration-2026-10-01",
      "permanent": false
    },
    {
      "source": "/reports/mo-home-campaign-configuration-2026-09-23.html",
      "destination": "/reports/home-campaign-configuration-2026-10-01",
      "permanent": false
    }
  ]
}
